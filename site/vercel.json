{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "export NODE_AUTH_TOKEN=\"$GITHUB_TOKEN_PACKAGES\" && npm ci",
  "build": {
    "env": {
      "MUSELAB_BRAND": "true"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/busbar-sf-source-format/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/busbar-sf-source-format/:path*/",
      "destination": "/:path*/index.html"
    },
    {
      "source": "/busbar-sf-source-format/",
      "destination": "/index.html"
    },
    {
      "source": "/busbar-sf-source-format/:path*",
      "destination": "/:path*"
    }
  ]
}
