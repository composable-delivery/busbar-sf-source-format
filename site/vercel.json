{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "export NODE_AUTH_TOKEN=\"$GITHUB_TOKEN_PACKAGES\" && npm ci && npm install --no-save --ignore-scripts @composable-delivery/muselab-ux-kit",
  "build": {
    "env": {
      "MUSELAB_BRAND": "true",
      "ASTRO_SITE": "https://docs.muselab.com",
      "ASTRO_BASE": "/busbar-sf-source-format"
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/busbar-sf-source-format/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/busbar-sf-source-format/:path*",
      "destination": "/:path*"
    }
  ]
}
