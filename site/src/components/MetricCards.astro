---
// Dashboard-style metric cards showing the RANGE of difference vs Node SDR across all benchmark
// scenarios. Data is computed from the benchmark results (local + GitHub Actions) by
// benchmarks/summarize.mjs; never hand-edit numbers here.
import summary from '../../.generated/benchmark-summary.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fmt = (v: number) => (v >= 10 ? Math.round(v).toString() : v.toFixed(1));
const span = (r: { min: number; max: number }) =>
  fmt(r.min) === fmt(r.max) ? `${fmt(r.min)}×` : `${fmt(r.min)}–${fmt(r.max)}×`;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;

const { inProcess, coldCli, suiteMemory, coldStartMs } = summary;

const cards = [
  {
    value: span(inProcess.speedup),
    unit: 'faster',
    title: 'Conversion speed',
    detail: `In-process, across ${plural(inProcess.scenarios, 'scenario')} on ${plural(inProcess.platforms, 'platform')}.`,
  },
  coldCli.speedup && {
    value: span(coldCli.speedup),
    unit: 'faster',
    title: 'Cold start in CI',
    detail: `Whole command vs the \`sf\` CLI, across ${plural(coldCli.scenarios, 'scenario')}.`,
  },
  (coldCli.memory ?? suiteMemory) && {
    value: span((coldCli.memory ?? suiteMemory)!),
    unit: 'less memory',
    title: 'Memory use',
    detail: coldCli.memory
      ? `Peak memory per run vs the \`sf\` CLI, across ${plural(coldCli.scenarios, 'scenario')}.`
      : 'Peak memory across the full benchmark suite.',
  },
  coldStartMs != null && {
    value: `${Math.max(1, Math.round(coldStartMs))} ms`,
    unit: 'to start',
    title: 'No runtime to boot',
    detail: 'A single native binary. No Node.js, no npm install, no warm-up.',
  },
].filter(Boolean) as { value: string; unit: string; title: string; detail: string }[];

const sources = summary.sources.map((s) => s.label).join(' · ');
---

<section class="metric-cards" aria-label="Performance compared with Salesforce SDR">
  <ul class="metric-grid">
    {
      cards.map((c) => (
        <li class="metric-card">
          <p class="metric-title">{c.title}</p>
          <p class="metric-value">
            <span class="metric-number">{c.value}</span>
            <span class="metric-unit">{c.unit}</span>
          </p>
          <p class="metric-detail" set:html={c.detail.replace(/`([^`]+)`/g, '<code>$1</code>')} />
        </li>
      ))
    }
  </ul>
  <p class="metric-note">
    Compared with <code>@salesforce/source-deploy-retrieve</code>
    {summary.sdrVersion} and the <code>sf</code> CLI. Measured on {sources}.{' '}
    <a href={`${base}/benchmarks/`}>See the full results and methodology.</a>
  </p>
</section>

<style>
  .metric-grid {
    list-style: none;
    padding: 0;
    margin: 1.25rem 0 0.75rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: 1rem;
  }
  .metric-card {
    margin: 0;
    padding: 1.25rem 1.25rem 1.1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    background: var(--sl-color-gray-6);
  }
  .metric-card p {
    margin: 0;
  }
  .metric-title {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .metric-value {
    margin-top: 0.35rem !important;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .metric-number {
    font-size: clamp(2rem, 1.4rem + 1.6vw, 2.75rem);
    font-weight: 700;
    line-height: 1.1;
    color: var(--sl-color-accent-high);
    font-variant-numeric: tabular-nums;
  }
  .metric-unit {
    font-size: var(--sl-text-lg);
    font-weight: 600;
    color: var(--sl-color-white);
  }
  .metric-detail {
    margin-top: 0.6rem !important;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    line-height: 1.5;
  }
  .metric-note {
    margin: 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>
